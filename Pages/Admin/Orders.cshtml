@page
@model Razor_WebApplication.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}
<section class="admin-page">
    <div class="section-heading"><div><span class="eyebrow">BÁN HÀNG</span><h2>Quản lý đơn hàng</h2></div><span class="muted">@Model.Orders.Count đơn hàng</span></div>
    @if (Model.Message is not null) { <div class="alert-success">@Model.Message</div> }
    <div class="table-wrap">
        <table class="data-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr><td>#@order.Id.ToString("D5")</td><td>@order.User.FullName<br /><small>@order.User.Email</small></td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@order.Items.Sum(item => item.Quantity) sản phẩm<br /><small>@string.Join(", ", order.Items.Select(item => $"{item.Product.Name} - EU {item.Size} (x{item.Quantity})"))</small></td><td>@order.Total.ToString("N0")₫</td><td><span class="status-pill">@order.Status</span></td><td><form method="post" asp-page-handler="UpdateStatus" class="status-form"><input type="hidden" name="id" value="@order.Id" /><select name="status"><option selected="@(order.Status == "Chờ xác nhận")">Chờ xác nhận</option><option selected="@(order.Status == "Đang giao")">Đang giao</option><option selected="@(order.Status == "Hoàn thành")">Hoàn thành</option><option selected="@(order.Status == "Đã hủy")">Đã hủy</option></select><button class="text-link">Lưu</button></form></td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
